# BuildMyWebsiteAI Environment Configuration Template
# Copy this file to .env and configure your secret credentials

# Database Connection (MySQL / PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./buildmywebsiteai_fallback.db"

# Google Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=""

# JWT Security Secrets (Generate a long random string in production)
JWT_SECRET="generate_a_random_secure_secret_for_production_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (For OTP & notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
